/*struct Node {
    int val;
    Node *next;
    Node() : val(0), next(nullptr) {}
    Node(int x) : val(x), next(nullptr) {}
    Node(int x, Node *n) : val(x), next(n) {}
  };
  */
class Solution {
public:
    Node* nextSmallerValue(Node* head) {
        vector<Node*> nodes;
        Node* curr = head;

        // Store all nodes
        while (curr != nullptr) {
            nodes.push_back(curr);
            curr = curr->next;
        }

        int n = nodes.size();
        vector<int> ans(n, -1);
        stack<int> st;

        // Find next smaller value from right to left
        for (int i = n - 1; i >= 0; i--) {
            while (!st.empty() && st.top() >= nodes[i]->val) {
                st.pop();
            }

            if (!st.empty()) {
                ans[i] = st.top();
            }

            st.push(nodes[i]->val);
        }

        // Update node values
        for (int i = 0; i < n; i++) {
            nodes[i]->val = ans[i];
        }

        return head;
    }
};